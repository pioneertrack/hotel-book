# Copy this file to .env and keep .env private.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/hotel_booking
# Replace with a long, random value before running the backend.
JWT_SECRET=replace-with-a-long-random-development-secret
# Optional: PayPal sandbox client ID for checkout. Leave blank to browse rooms without payments.
PAYPAL_CLIENT_ID=
